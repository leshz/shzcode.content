---
/**
 * Services Component - Grid showing services offered
 */
---

<div class="section service" id="section-services">
  <div class="content">
    <div class="title">
      <div class="title_inner">My Services</div>
    </div>
    <div class="service-items">
      <div class="service-item">
        <div class="icon">
          <span class="ion ion-social-html5"></span>
        </div>
        <div class="name">Front-end Development</div>
        <p>Modern, responsive interfaces with React, Vue, and cutting-edge technologies.</p>
      </div>
      <div class="service-item">
        <div class="icon">
          <span class="ion ion-code"></span>
        </div>
        <div class="name">Full-stack Development</div>
        <p>Complete web applications from database to deployment with Node.js and cloud services.</p>
      </div>
      <div class="service-item">
        <div class="icon">
          <span class="ion ion-social-chrome"></span>
        </div>
        <div class="name">Web Architecture</div>
        <p>Scalable architecture design, performance optimization, and best practices.</p>
      </div>
      <div class="service-item">
        <div class="icon">
          <span class="ion ion-ipad"></span>
        </div>
        <div class="name">UI/UX Design</div>
        <p>User-centered design with focus on accessibility and modern aesthetics.</p>
      </div>
      <div class="service-item">
        <div class="icon">
          <span class="ion ion-ios-search-strong"></span>
        </div>
        <div class="name">Code Review & Consulting</div>
        <p>Expert analysis and recommendations for improving code quality and performance.</p>
      </div>
      <div class="service-item">
        <div class="icon">
          <span class="ion ion-help-buoy"></span>
        </div>
        <div class="name">Technical Support</div>
        <p>Ongoing maintenance, updates, and technical assistance for your projects.</p>
      </div>
    </div>
  </div>
</div>

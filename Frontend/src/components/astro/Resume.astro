---
/**
 * Resume Component - Timeline showing experience and education
 */
---

<div class="section resume" id="section-history">
  <div class="content">
    <div class="cols">
      <div class="col col-md">
        <div class="title">
          <div class="title_inner">Experience</div>
        </div>
        <div class="resume-items">
          <div class="resume-item active">
            <div class="date">2020 - Present</div>
            <div class="name">Front-end Director - Tech Company</div>
            <p>
              Leading front-end development teams, architecting scalable web applications,
              and implementing modern JavaScript frameworks. Focused on performance optimization
              and user experience excellence.
            </p>
          </div>
          <div class="resume-item">
            <div class="date">2018 - 2020</div>
            <div class="name">Senior Fullstack Developer</div>
            <p>
              Developed full-stack web applications using React, Node.js, and modern databases.
              Implemented CI/CD pipelines and mentored junior developers in best practices.
            </p>
          </div>
          <div class="resume-item">
            <div class="date">2016 - 2018</div>
            <div class="name">Web Developer</div>
            <p>
              Built responsive websites and web applications. Worked with various CMS platforms
              and e-commerce solutions. Collaborated with designers to create pixel-perfect implementations.
            </p>
          </div>
        </div>
      </div>
      <div class="col col-md">
        <div class="title">
          <div class="title_inner">Education</div>
        </div>
        <div class="resume-items">
          <div class="resume-item">
            <div class="date">2015 - 2020</div>
            <div class="name">Self-Taught Developer</div>
            <p>
              Continuous learning through online courses, bootcamps, and hands-on projects.
              Specialized in modern JavaScript, React, TypeScript, and cloud technologies.
            </p>
          </div>
          <div class="resume-item">
            <div class="date">2014 - 2015</div>
            <div class="name">Web Development Fundamentals</div>
            <p>
              Completed comprehensive courses in HTML, CSS, JavaScript, and responsive design.
              Built foundational knowledge in web standards and accessibility.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

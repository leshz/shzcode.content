---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/layouts/Footer.astro';
import About from '@/components/astro/About.astro';
import Resume from '@/components/astro/Resume.astro';
import Services from '@/components/astro/Services.astro';
import ContactsInfo from '@/components/astro/ContactsInfo.astro';
---

<BaseLayout
  title="Jeff Barragán - Front-end Director & Fullstack Developer"
  description="Portfolio personal de Jeff Barragán. Front-end Director, Fullstack Developer y entusiasta de las criptomonedas. Basado en Colombia."
  theme="orange"
>
  <!-- Hero Section - Will be React Island in Phase 3 -->
  <div class="section started" id="section-started" style="height: 100vh;">
    <div class="centrize full-width">
      <div class="vertical-center">
        <div class="started-content">
          <div class="h-title glitch-effect" data-text="I'm Jeff Barragán">
            I'm <span>Jeff Barragán</span>
          </div>
          <div class="h-subtitles">
            <div class="h-subtitle typing-subtitle">
              <p>Front-end Director</p>
              <p>Fullstack Developer</p>
              <p>UX/UI Designer</p>
              <p>Cryptocurrency Enthusiast</p>
              <p>Based in Colombia</p>
            </div>
            <span class="typed-subtitle"></span>
          </div>
        </div>
      </div>
    </div>
    <a href="#section-resume" class="mouse_btn">
      <span class="ion ion-mouse"></span>
    </a>
  </div>

  <!-- About Section -->
  <About />

  <!-- Resume Section -->
  <Resume />

  <!-- Skills Section - Will be React Island in Phase 3 -->
  <div class="section skills" id="section-skills">
    <div class="content">
      <div class="title">
        <div class="title_inner">Skills</div>
      </div>
      <div class="skills">
        <ul>
          <li>
            <div class="name">JavaScript / TypeScript</div>
            <div class="progress">
              <div class="percentage" style="width: 95%;"></div>
            </div>
          </li>
          <li>
            <div class="name">React / Next.js / Astro</div>
            <div class="progress">
              <div class="percentage" style="width: 90%;"></div>
            </div>
          </li>
          <li>
            <div class="name">Node.js / Express</div>
            <div class="progress">
              <div class="percentage" style="width: 85%;"></div>
            </div>
          </li>
          <li>
            <div class="name">CSS / Tailwind / Styled Components</div>
            <div class="progress">
              <div class="percentage" style="width: 92%;"></div>
            </div>
          </li>
          <li>
            <div class="name">Git / CI/CD / Cloud Services</div>
            <div class="progress">
              <div class="percentage" style="width: 88%;"></div>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Services Section -->
  <Services />

  <!-- Clients Section - Will be React Island in Phase 3 -->
  <!-- Portfolio Section - Will be React Island in Phase 3 -->
  <!-- Blog Section - Will be React Island in Phase 3 -->

  <!-- Contacts Section -->
  <ContactsInfo />

  <!-- Footer -->
  <Footer />
</BaseLayout>

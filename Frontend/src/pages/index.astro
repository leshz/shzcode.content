---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="shzcode.tech - Migración a Astro">
  <div class="section started" style="height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div class="centrize full-width">
      <div class="vertical-center">
        <div style="text-align: center; padding: 40px;">
          <h1 class="glitch-effect" data-text="shzcode.tech">
            shzcode.tech
          </h1>
          <h2 style="margin-top: 20px;">🚀 Migración a Astro - Fase 1 Completada</h2>

          <div style="max-width: 600px; margin: 40px auto; text-align: left;">
            <h3>✅ CSS Migrado y Modernizado:</h3>
            <ul style="list-style: disc; padding-left: 30px; margin-top: 20px;">
              <li style="margin-bottom: 10px;"><strong>theme.css</strong> - Sistema de variables CSS</li>
              <li style="margin-bottom: 10px;"><strong>global.css</strong> - Estilos base modernizados (sin prefijos)</li>
              <li style="margin-bottom: 10px;"><strong>animations.css</strong> - Animaciones de Glitche</li>
              <li style="margin-bottom: 10px;"><strong>ionicons.css</strong> - Iconos</li>
              <li style="margin-bottom: 10px;"><strong>layout.css</strong> - Layout completo (2402 líneas)</li>
              <li style="margin-bottom: 10px;"><strong>Fuentes Roboto Mono</strong> - 5 weights configurados</li>
            </ul>
          </div>

          <div style="margin-top: 40px;">
            <a href="#" class="btn fill">Siguiente: Componentes Astro →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
